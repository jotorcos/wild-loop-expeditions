  action="https://formspree.io/f/mgaagaza"
  method="POST"
>
  <input
    type="hidden"
    name="_subject"
    value="Wild Loop Expeditions enquiry"
  />
            <div class="form-grid">
              <div class="field"><label for="name">Your name *</label><input id="name" name="name" autocomplete="name" required maxlength="100" placeholder="Name" /></div>
              <div class="field"><label for="email">Email address *</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="160" placeholder="you@example.com" /></div>
              <div class="field"><label for="country">Country</label><input id="country" name="country" autocomplete="country-name" maxlength="80" placeholder="Where are you based?" /></div>
              <div class="field"><label for="dates">When are you thinking?</label><input id="dates" name="dates" maxlength="100" placeholder="A month, season or dates" /></div>
              <div class="field"><label for="participants">Number of riders</label><select id="participants" name="participants"><option value="">Select</option><option>1</option><option>2</option><option>3–4</option><option>5–8</option><option>Not sure yet</option></select></div>
              <div class="field"><label for="style">Preferred riding</label><select id="style" name="style"><option value="">Select</option><option>Gravel</option><option>Road</option><option>Mixed terrain</option><option>Not sure yet</option></select></div>
              <div class="field"><label for="level">Experience / fitness</label><input id="level" name="level" maxlength="180" placeholder="Tell us what a good ride feels like" /></div>
              <div class="field"><label for="duration">Trip duration</label><input id="duration" name="duration" maxlength="100" placeholder="For example, 4–5 days" /></div>
              <div class="field full"><label for="message">Your trip idea *</label><textarea id="message" name="message" required maxlength="3000" placeholder="The kind of places, riding or moments you are hoping to find…"></textarea></div>
            </div>
            <button class="button form-submit" type="submit">Start planning your expedition <span aria-hidden="true">↗</span></button>
            <div id="form-status" class="form-status" role="status" aria-live="polite" hidden><strong>Your enquiry is ready, but it has not been sent.</strong><br />This website does not yet have a submission service. Copy your enquiry below and send it through your preferred email once a contact address is configured.<textarea id="enquiry-copy" readonly aria-label="Prepared enquiry text"></textarea><button class="copy-button" id="copy-enquiry" type="button">Copy enquiry</button><span id="copy-status" aria-live="polite"></span></div>
          </form>
        </div>
      </section>
    </main>
    <footer class="footer"><div class="wrap footer-inner"><a class="brand" href="#home"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 16.8c1.8-4.9 5.2-9.2 9.5-9.2 3.3 0 5.3 2.4 4.4 4.7-.7 1.8-3.1 2.1-4.5.8-1-1-.7-2.7.1-3.8M4 16.8h7.1c2.8 0 4.9-1 6.8-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></span><span>WILD LOOP<span>EXPEDITIONS</span></span></a><p>GO FURTHER. STAY WILD. · EASTERN SPAIN</p><a href="#home">Back to top ↑</a></div></footer>
    <script>
      const menuButton = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#primary-nav');
      menuButton?.addEventListener('click', () => {
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!isOpen));
        nav?.classList.toggle('open', !isOpen);
        menuButton.textContent = isOpen ? 'Menu' : 'Close';
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        nav.classList.remove('open');
        menuButton?.setAttribute('aria-expanded', 'false');
        if (menuButton) menuButton.textContent = 'Menu';
      }));

      const form = document.querySelector('#enquiry-form');
      const status = document.querySelector('#form-status');
      const output = document.querySelector('#enquiry-copy');
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const data = new FormData(form);
        const fields = [
          ['Name', 'name'], ['Email', 'email'], ['Country', 'country'], ['Preferred dates / season', 'dates'],
          ['Number of participants', 'participants'], ['Riding style', 'style'], ['Experience / fitness', 'level'],
          ['Desired duration', 'duration'], ['Trip idea', 'message'],
        ];
        const enquiry = fields.map(([label, key]) => `${label}: ${data.get(key) || 'Not specified'}`).join('\\n');
        if (output) output.value = `WILD LOOP EXPEDITIONS — NEW ENQUIRY\\n\\n${enquiry}`;
        if (status) { status.hidden = false; status.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
      });
      document.querySelector('#copy-enquiry')?.addEventListener('click', async () => {
        const output = document.querySelector('#enquiry-copy');
        const feedback = document.querySelector('#copy-status');
        if (!output || !feedback) return;
        try { await navigator.clipboard.writeText(output.value); feedback.textContent = ' Copied.'; }
        catch { output.focus(); output.select(); feedback.textContent = ' Select and copy the text above.'; }
      });
    </script>
  </body>
</html>
